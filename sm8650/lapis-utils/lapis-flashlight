#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu
usage() { echo "usage: lapis-flashlight {on [0-100]|off|status}" >&2; exit 2; }
command=${1:-}
case "$command" in
	on)
		requested_level=${2:-40}
		[ "$#" -le 2 ] || usage
		case "$requested_level" in
			''|*[!0-9]*) usage ;;
		esac
		[ "$requested_level" -le 100 ] || usage
		;;
	off|status)
		requested_level=
		[ "$#" -le 1 ] || usage
		;;
	*) usage ;;
esac
sysfs_flash_nodes() {
	# LED class entries are symlinks into the device tree, not directories.
	find /sys/class/leds -maxdepth 1 \( -name '*flash*' -o -name '*torch*' \) \
		\( -type l -o -type d \) 2>/dev/null | sort -u
}
nodes=$(sysfs_flash_nodes)
if [ -z "$nodes" ]; then
	if [ "$command" = status ]; then
		echo "flashlight: unavailable (PM8550 flash LED not in DT / module not loaded; cameras not brought up yet)"
		exit 0
	fi
	echo "lapis-flashlight: no flash LED sysfs nodes" >&2
	exit 1
fi
if [ "$command" = status ]; then
	for node in $nodes; do
		printf '%s brightness=%s max=%s\n' \
			"${node##*/}" "$(cat "$node/brightness")" "$(cat "$node/max_brightness")"
	done
	exit 0
fi
for node in $nodes; do
	max=$(cat "$node/max_brightness")
	if [ "$command" = on ]; then
		value=$((requested_level * max / 100))
		[ "$value" -ge 1 ] || value=1
		printf '%s\n' "$value" >"$node/brightness"
	else
		printf '0\n' >"$node/brightness"
	fi
done
