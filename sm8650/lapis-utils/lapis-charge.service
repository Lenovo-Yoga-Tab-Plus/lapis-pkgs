[Unit]
Description=Restore TB520FU charge-limit preferences
After=systemd-udev-trigger.service
ConditionPathExists=/etc/lapis-charge.json
ConditionPathExists=/sys/class/power_supply/qcom-battmgr-bat/charge_control_end_threshold

[Service]
Type=oneshot
ExecStart=/usr/bin/lapis-charge apply
RemainAfterExit=yes
TimeoutStartSec=15

[Install]
WantedBy=multi-user.target
