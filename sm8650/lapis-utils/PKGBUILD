pkgname=lapis-utils
pkgver=1.0
pkgrel=7
pkgdesc='Slot, charge, flashlight, factory MAC, tablet-mode, Android auto-brightness, and clock tools for the Lenovo Yoga Tab Plus'
arch=('any')
license=('GPL-2.0-only')
depends=('python' 'python-gobject' 'libgpiod' 'iproute2' 'bluez-utils')
# qbootctl -s moves the active flag without the partition type GUIDs and leaves
# this tablet stuck in fastboot. lapis-slot marks the slot itself, so an
# upgrade takes qbootctl off the system.
conflicts=('qbootctl')
replaces=('qbootctl')
source=(
  'lapis-hardware-mac'
  'lapis-slot'
  'lapis-charge'
  'lapis-flashlight'
  'lapis-tablet-mode'
  'lapis-flash.conf'
  'mnt-persist.mount'
  'lapis-hardware-mac.service'
  'lapis-charge.service'
  'lapis-tablet-mode.service'
  'lapis-autobright'
  'lapis-autobright.service'
  'lapis-clock'
  'lapis-clock-restore.service'
  'lapis-clock-save.service'
  'lapis-gsd-brightness.c'
  'lapis-gsd-brightness.conf'
  'org.lapis.flashlight.policy'
  'torch-extension.js'
  'torch-metadata.json'
  'lapis-privacy-led'
  'lapis-privacy-led.service'
  'lapis-privacy-led.conf'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
  gcc -shared -fPIC -O2 -Wall -Wextra -o liblapis-gsd-brightness.so lapis-gsd-brightness.c -ldl
}

package() {
  install -Dm755 lapis-hardware-mac "$pkgdir/usr/bin/lapis-hardware-mac"
  install -Dm755 lapis-slot "$pkgdir/usr/bin/lapis-slot"
  install -Dm755 lapis-charge "$pkgdir/usr/bin/lapis-charge"
  install -Dm755 lapis-flashlight "$pkgdir/usr/bin/lapis-flashlight"
  install -Dm755 lapis-tablet-mode "$pkgdir/usr/bin/lapis-tablet-mode"
  install -Dm755 lapis-autobright "$pkgdir/usr/bin/lapis-autobright"
  install -Dm755 lapis-clock "$pkgdir/usr/bin/lapis-clock"
  install -Dm644 lapis-flash.conf \
    "$pkgdir/usr/lib/modules-load.d/lapis-flash.conf"
  install -Dm644 mnt-persist.mount \
    "$pkgdir/usr/lib/systemd/system/mnt-persist.mount"
  install -Dm644 lapis-hardware-mac.service \
    "$pkgdir/usr/lib/systemd/system/lapis-hardware-mac.service"
  install -Dm644 lapis-charge.service \
    "$pkgdir/usr/lib/systemd/system/lapis-charge.service"
  install -Dm644 lapis-tablet-mode.service \
    "$pkgdir/usr/lib/systemd/system/lapis-tablet-mode.service"
  install -Dm644 lapis-autobright.service \
    "$pkgdir/usr/lib/systemd/system/lapis-autobright.service"
  install -Dm644 lapis-clock-restore.service \
    "$pkgdir/usr/lib/systemd/system/lapis-clock-restore.service"
  install -Dm644 lapis-clock-save.service \
    "$pkgdir/usr/lib/systemd/system/lapis-clock-save.service"
  install -Dm755 liblapis-gsd-brightness.so \
    "$pkgdir/usr/lib/lapis/liblapis-gsd-brightness.so"
  install -Dm644 lapis-gsd-brightness.conf \
    "$pkgdir/usr/lib/systemd/user/org.gnome.SettingsDaemon.Power.service.d/lapis-brightness.conf"
  install -Dm644 org.lapis.flashlight.policy \
    "$pkgdir/usr/share/polkit-1/actions/org.lapis.flashlight.policy"
  install -Dm644 torch-extension.js \
    "$pkgdir/usr/share/gnome-shell/extensions/torch@lapis/extension.js"
  install -Dm644 torch-metadata.json \
    "$pkgdir/usr/share/gnome-shell/extensions/torch@lapis/metadata.json"
  install -Dm755 lapis-privacy-led "$pkgdir/usr/bin/lapis-privacy-led"
  install -Dm644 lapis-privacy-led.service \
    "$pkgdir/usr/lib/systemd/system/lapis-privacy-led.service"
  install -Dm644 lapis-privacy-led.conf \
    "$pkgdir/usr/lib/modules-load.d/lapis-privacy-led.conf"
  install -d "$pkgdir/usr/lib/systemd/system/local-fs.target.wants" \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" \
    "$pkgdir/usr/lib/systemd/system/sysinit.target.wants" \
    "$pkgdir/usr/lib/systemd/system/time-sync.target.wants"
  ln -s ../mnt-persist.mount \
    "$pkgdir/usr/lib/systemd/system/local-fs.target.wants/mnt-persist.mount"
  ln -s ../lapis-hardware-mac.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/lapis-hardware-mac.service"
  ln -s ../lapis-charge.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/lapis-charge.service"
  ln -s ../lapis-tablet-mode.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/lapis-tablet-mode.service"
  ln -s ../lapis-autobright.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/lapis-autobright.service"
  ln -s ../lapis-privacy-led.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/lapis-privacy-led.service"
  ln -s ../lapis-clock-restore.service \
    "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/lapis-clock-restore.service"
  ln -s ../lapis-clock-save.service \
    "$pkgdir/usr/lib/systemd/system/time-sync.target.wants/lapis-clock-save.service"
}
