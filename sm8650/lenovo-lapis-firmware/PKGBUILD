pkgname=lenovo-lapis-firmware
pkgver=1.0
pkgrel=2
pkgdesc='Firmware staging helper for the Lenovo Yoga Tab Plus'
arch=('any')
license=('GPL-2.0-only')
depends=('linux-firmware-qcom')
source=('stage-lapis-firmware.sh' 'pil_squash.py')
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 stage-lapis-firmware.sh \
    "$pkgdir/usr/lib/lapis/stage-lapis-firmware.sh"
  install -Dm755 pil_squash.py \
    "$pkgdir/usr/lib/lapis/pil_squash.py"

  # The device blobs ship in firmware/ next to this PKGBUILD.
  # LAPIS_FIRMWARE_ROOT replaces that tree when a build has a newer dump.
  firmware_root="${LAPIS_FIRMWARE_ROOT:-$startdir/firmware}"
  if [ ! -d "$firmware_root/usr/lib/firmware" ] && [ ! -d "$firmware_root/qcom" ]; then
    echo "Device firmware tree not available; shipping the staging scripts only."
    return 0
  fi

  if [ -d "$firmware_root/usr/lib/firmware" ]; then
    src_fw="$firmware_root/usr/lib/firmware"
    src_share="$firmware_root/usr/share/qcom"
  else
    src_fw="$firmware_root"
    src_share=""
  fi

  mkdir -p "$pkgdir/usr/lib/firmware"
  cp -a "$src_fw/." "$pkgdir/usr/lib/firmware/"
  if [ -n "$src_share" ] && [ -d "$src_share" ]; then
    mkdir -p "$pkgdir/usr/share/qcom"
    cp -a "$src_share/." "$pkgdir/usr/share/qcom/"
  fi
}
