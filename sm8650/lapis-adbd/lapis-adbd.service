[Unit]
Description=TB520FU ADB over the existing USB NCM+ACM gadget
After=sys-kernel-config.mount systemd-modules-load.service systemd-udevd.service local-fs.target
Requires=sys-kernel-config.mount
ConditionPathExists=/usr/bin/adbd
ConditionPathExistsGlob=/sys/class/udc/*
ConditionPathExists=/sys/kernel/config/usb_gadget/g1

[Service]
Type=notify
NotifyAccess=all
Environment=HOME=/root
Environment=LD_LIBRARY_PATH=/usr/lib/lapis-adbd
Environment=ADBD_USER=root
ExecStartPre=+/usr/bin/lapis-adbd-gadget setup
ExecStart=/usr/bin/lapis-adbd-run
ExecStartPost=+/usr/bin/lapis-adbd-gadget bind
ExecStopPost=+/usr/bin/lapis-adbd-gadget teardown
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
