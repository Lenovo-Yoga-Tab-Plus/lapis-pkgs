#!/usr/bin/env python3
"""Speaker profiles for the Yoga Tab Plus.

The Android Dolby library (libswdap.so) is proprietary and is not bundled.
These profiles use the speaker_landscape numbers from that tablet's tuning:
the audio-optimizer bands, a bass shelf, and a dialog bump that follows the
Dynamic / Music / Movie / Voice amounts. A limiter keeps the amplifiers from
clipping, which is the job Dolby's regulator does in the closed library.

Profile changes fade the live filter controls. The audio graph is rebuilt
only when those controls are not loaded yet.
"""

import argparse
import json
import math
import subprocess
import sys
import time
from pathlib import Path

CONF = Path.home() / ".config/wireplumber/wireplumber.conf.d/lapis-speaker-dsp.conf"
STATE = Path.home() / ".config/lapis/speaker.json"
SINK = "effect_output.lapis-speaker"

# Audio-optimizer bands from dax-default.xml, speaker_landscape, in dB.
OPTIMIZER = [
    (47.0, 0.90, -4.125),
    (141.0, 1.41, 0.938),
    (234.0, 2.45, 1.688),
    (328.0, 2.85, 0.750),
    (469.0, 2.89, -3.688),
    (656.0, 3.46, -7.0),
    (844.0, 4.47, -1.25),
    (1313.0, 4.04, 1.0),
    (1688.0, 3.67, 1.5),
    (2250.0, 3.47, -1.062),
    (3000.0, 3.97, -1.938),
    (3750.0, 4.47, -2.562),
    (4688.0, 4.56, -1.0),
    (7125.0, 4.53, -5.75),
    (9000.0, 4.38, -10.0),
    (11250.0, 4.63, -12.5),
    (13875.0, 3.44, -9.438),
    (19688.0, 3.60, -5.5),
]

# bass / dialog / loudness are the per-profile differences that are safe to
# apply. Loudness is limiter input gain, capped so the -9 dB ceiling still
# holds the amplifiers under full scale. Android's own volmax is larger
# because its multiband limiter is doing the holding.
PROFILES = {
    "dynamic": {"label": "Dynamic", "bass": 1.0, "dialog": 0.0, "loudness": 0.0, "highpass": 100.0},
    "music": {"label": "Music", "bass": 1.5, "dialog": 0.0, "loudness": 1.0, "highpass": 100.0},
    "movie": {"label": "Movie", "bass": 1.0, "dialog": 1.5, "loudness": 1.5, "highpass": 90.0},
    "voice": {"label": "Voice", "bass": 0.0, "dialog": 2.0, "loudness": 0.0, "highpass": 140.0},
    "off": {"label": "Off", "bass": 0.0, "dialog": 0.0, "loudness": 0.0, "highpass": 100.0},
}
ORDER = ["dynamic", "music", "movie", "voice", "off"]
LIVE_KEYS = ("hp", "bass", "dialog", "loud", "mix")


def targets(profile, bass, dialog, loudness):
    if profile == "off":
        return {"hp": 100.0, "bass": bass, "dialog": dialog, "loud": 0.0, "mix": 0.0}
    return {
        "hp": PROFILES[profile]["highpass"],
        "bass": bass,
        "dialog": dialog,
        "loud": loudness,
        "mix": 1.0,
    }


def params_from_live(live):
    mix = live["mix"]
    wet = math.sin(mix * math.pi / 2.0)
    dry = math.cos(mix * math.pi / 2.0)
    return {
        "hpL:Freq": live["hp"],
        "hpR:Freq": live["hp"],
        "bassL:Gain": live["bass"],
        "bassR:Gain": live["bass"],
        "dlgL:Gain": live["dialog"],
        "dlgR:Gain": live["dialog"],
        "mixL:Gain 1": wet,
        "mixR:Gain 1": wet,
        "mixL:Gain 2": dry,
        "mixR:Gain 2": dry,
        "lim:Input gain (dB)": live["loud"] * mix,
        "lim:Limit (dB)": -9.0 * mix,
    }


def approach(live, target):
    nxt = {}
    done = True
    for key in LIVE_KEYS:
        dest = target[key]
        cur = live.get(key, dest)
        step = cur + (dest - cur) * 0.38
        tol = 0.4 if key == "hp" else 0.015
        if abs(dest - step) <= tol:
            step = dest
        else:
            done = False
        nxt[key] = step
    return nxt, done


def render(profile, bass, dialog, loudness):
    live = targets(profile, bass, dialog, loudness)
    params = params_from_live(live)
    opt = "\n                ".join(
        f"{{ type = bq_peaking freq = {freq:.1f} q = {q:.2f} gain = {gain:.3f} }}"
        for freq, q, gain in ((400.0, 1.0, -2.0), *OPTIMIZER)
    )
    return f"""# Generated by lapis-speaker. Speakers only.
wireplumber.profiles = {{
  main = {{
    filter.sink.lapis-speaker = required
  }}
}}

wireplumber.components = [
  {{
    name = libpipewire-module-filter-chain, type = pw-module-client
    arguments = {{
      node.description = "Speaker processing"
      media.name = "Speaker processing"
      filter.graph = {{
        nodes = [
          {{ type = builtin name = tapL label = copy }}
          {{ type = builtin name = tapR label = copy }}
          {{
            type = builtin name = hpL label = bq_highpass
            control = {{ "Freq" = {params["hpL:Freq"]:.2f} "Q" = 0.707 "Gain" = 0.0 }}
          }}
          {{
            type = builtin name = hpR label = bq_highpass
            control = {{ "Freq" = {params["hpR:Freq"]:.2f} "Q" = 0.707 "Gain" = 0.0 }}
          }}
          {{
            type = builtin name = bassL label = bq_lowshelf
            control = {{ "Freq" = 264.0 "Q" = 0.707 "Gain" = {params["bassL:Gain"]:.2f} }}
          }}
          {{
            type = builtin name = bassR label = bq_lowshelf
            control = {{ "Freq" = 264.0 "Q" = 0.707 "Gain" = {params["bassR:Gain"]:.2f} }}
          }}
          {{
            type = builtin name = dlgL label = bq_peaking
            control = {{ "Freq" = 2500.0 "Q" = 0.8 "Gain" = {params["dlgL:Gain"]:.2f} }}
          }}
          {{
            type = builtin name = dlgR label = bq_peaking
            control = {{ "Freq" = 2500.0 "Q" = 0.8 "Gain" = {params["dlgR:Gain"]:.2f} }}
          }}
          {{
            type = builtin name = tone label = param_eq
            config = {{
              filters = [
                {opt}
              ]
            }}
          }}
          {{
            type = builtin name = mixL label = mixer
            control = {{ "Gain 1" = {params["mixL:Gain 1"]:.4f} "Gain 2" = {params["mixL:Gain 2"]:.4f} }}
          }}
          {{
            type = builtin name = mixR label = mixer
            control = {{ "Gain 1" = {params["mixR:Gain 1"]:.4f} "Gain 2" = {params["mixR:Gain 2"]:.4f} }}
          }}
          {{
            type = ladspa
            name = lim
            plugin = fast_lookahead_limiter_1913
            label = fastLookaheadLimiter
            control = {{
              "Input gain (dB)" = {params["lim:Input gain (dB)"]:.2f}
              "Limit (dB)" = {params["lim:Limit (dB)"]:.2f}
              "Release time (s)" = 0.05
            }}
          }}
        ]
        links = [
          {{ output = "tapL:Out" input = "hpL:In" }}
          {{ output = "tapR:Out" input = "hpR:In" }}
          {{ output = "hpL:Out" input = "bassL:In" }}
          {{ output = "hpR:Out" input = "bassR:In" }}
          {{ output = "bassL:Out" input = "dlgL:In" }}
          {{ output = "bassR:Out" input = "dlgR:In" }}
          {{ output = "dlgL:Out" input = "tone:In 1" }}
          {{ output = "dlgR:Out" input = "tone:In 2" }}
          {{ output = "tone:Out 1" input = "mixL:In 1" }}
          {{ output = "tone:Out 2" input = "mixR:In 1" }}
          {{ output = "tapL:Out" input = "mixL:In 2" }}
          {{ output = "tapR:Out" input = "mixR:In 2" }}
          {{ output = "mixL:Out" input = "lim:Input 1" }}
          {{ output = "mixR:Out" input = "lim:Input 2" }}
        ]
        inputs = [ "tapL:In" "tapR:In" ]
        outputs = [ "lim:Output 1" "lim:Output 2" ]
      }}
      audio.channels = 2
      audio.position = [ FL, FR ]
      capture.props = {{
        node.name = "effect_output.lapis-speaker"
        media.class = "Audio/Sink"
        filter.smart = true
        filter.smart.name = "filter.sink.lapis-speaker"
        filter.smart.target = "{{ \\"node.name\\" = \\"alsa_output.platform-sound.HiFi__Speaker__sink\\" }}"
      }}
      playback.props = {{
        node.name = "effect_input.lapis-speaker"
        node.passive = true
        node.dont-fallback = true
        media.role = "DSP"
      }}
    }}
    provides = filter.sink.lapis-speaker
    requires = [ support.client-context ]
  }}
]
"""


def save_state(profile, bass, dialog, loudness):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps({
        "profile": profile,
        "bass": bass,
        "dialog": dialog,
        "loudness": loudness,
    }, indent=2) + "\n")


def load_state():
    try:
        data = json.loads(STATE.read_text())
    except (OSError, json.JSONDecodeError):
        data = {}
    profile = data.get("profile", "dynamic")
    if profile not in PROFILES:
        profile = "dynamic"
    spec = PROFILES[profile]
    return (
        profile,
        float(data.get("bass", spec["bass"])),
        float(data.get("dialog", spec["dialog"])),
        float(data.get("loudness", spec["loudness"])),
    )


def write_conf(profile, bass, dialog, loudness):
    CONF.parent.mkdir(parents=True, exist_ok=True)
    CONF.write_text(render(profile, bass, dialog, loudness))
    save_state(profile, bass, dialog, loudness)


def find_filter_node():
    try:
        raw = subprocess.check_output(["pw-dump"], text=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    for obj in json.loads(raw):
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("node.name") == SINK:
            return obj.get("id")
    return None


def has_live_controls(node):
    try:
        out = subprocess.check_output(
            ["pw-cli", "enum-params", str(node), "Props"],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.CalledProcessError):
        return False
    return "hpL:Freq" in out


def push_params(node, live):
    parts = " ".join(
        f'"{key}" {value:.4f}' for key, value in params_from_live(live).items()
    )
    subprocess.run(
        ["pw-cli", "set-param", str(node), "Props", "{ params = [ " + parts + " ] }"],
        check=True,
        capture_output=True,
        text=True,
    )


def restart_audio():
    subprocess.run(["systemctl", "--user", "restart", "wireplumber"], check=True)


def ensure_graph(profile, bass, dialog, loudness):
    """Load the fader graph. Returns the node id once live controls exist."""
    write_conf(profile, bass, dialog, loudness)
    node = find_filter_node()
    if node is not None and has_live_controls(node):
        return node
    restart_audio()
    time.sleep(0.6)
    node = find_filter_node()
    if node is None or not has_live_controls(node):
        raise RuntimeError("speaker graph did not load")
    return node


def fade(node, start, target):
    live = dict(start)
    for _ in range(24):
        live, done = approach(live, target)
        push_params(node, live)
        if done:
            return live
        time.sleep(0.03)
    push_params(node, target)
    return dict(target)


def apply_settings(profile, bass, dialog, loudness, fade_from=None):
    node = ensure_graph(profile, bass, dialog, loudness)
    target = targets(profile, bass, dialog, loudness)
    # A restart already opened the graph at the target values.
    if fade_from is None:
        return node, target
    return node, fade(node, fade_from, target)


def main_cli(argv):
    parser = argparse.ArgumentParser(description="Yoga Tab Plus speaker profiles")
    parser.add_argument("--apply", choices=ORDER, help="fade to a profile")
    parser.add_argument(
        "--apply-if-missing",
        action="store_true",
        help="write the Dynamic profile when no user config exists yet",
    )
    args = parser.parse_args(argv)
    if args.apply_if_missing:
        if not CONF.exists():
            spec = PROFILES["dynamic"]
            apply_settings("dynamic", spec["bass"], spec["dialog"], spec["loudness"])
        return 0
    if args.apply:
        spec = PROFILES[args.apply]
        current = targets(*load_state())
        apply_settings(
            args.apply, spec["bass"], spec["dialog"], spec["loudness"], fade_from=current
        )
        return 0
    return None


def main_gui():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    class SpeakerApp(Adw.Application):
        def __init__(self):
            super().__init__(application_id="page.lapis.Speaker")
            self.profile, self.bass, self.dialog, self.loudness = load_state()
            self.live = targets(self.profile, self.bass, self.dialog, self.loudness)
            self.target = dict(self.live)
            self.node = None
            self.ramp_id = None
            self.suppress = False

        def do_activate(self):
            if self.get_active_window() is not None:
                self.get_active_window().present()
                return
            win = Adw.PreferencesWindow(application=self, title="Speaker profiles")
            win.set_default_size(440, 520)

            page = Adw.PreferencesPage()
            group = Adw.PreferencesGroup(
                title="Speakers",
                description="Profiles follow the tablet's Android speaker tuning. "
                "The proprietary Dolby processor is not included; a limiter keeps high volume from rattling the drivers.",
            )

            self.profile_row = Adw.ComboRow(title="Profile")
            names = Gtk.StringList.new([PROFILES[key]["label"] for key in ORDER])
            self.profile_row.set_model(names)
            self.profile_row.set_selected(ORDER.index(self.profile))
            self.profile_row.connect("notify::selected", self.on_profile)
            group.add(self.profile_row)

            self.bass_row = self.slider("Bass", -2, 3, 0.5, self.bass)
            self.dialog_row = self.slider("Dialog", 0, 3, 0.5, self.dialog)
            self.loud_row = self.slider("Loudness", 0, 3, 0.5, self.loudness)
            group.add(self.bass_row)
            group.add(self.dialog_row)
            group.add(self.loud_row)

            self.status = Adw.ActionRow(title=PROFILES[self.profile]["label"])
            group.add(self.status)

            page.add(group)
            win.add(page)
            self.sync_sensitive()
            win.present()

        def slider(self, title, low, high, step, value):
            row = Adw.ActionRow(title=title)
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
            scale.set_value(value)
            scale.set_draw_value(True)
            scale.set_hexpand(True)
            scale.set_size_request(180, -1)
            scale.set_value_pos(Gtk.PositionType.RIGHT)
            scale.connect("value-changed", self.on_slider)
            row.add_suffix(scale)
            row.scale = scale
            return row

        def on_profile(self, row, _param):
            key = ORDER[row.get_selected()]
            spec = PROFILES[key]
            self.suppress = True
            self.bass_row.scale.set_value(spec["bass"])
            self.dialog_row.scale.set_value(spec["dialog"])
            self.loud_row.scale.set_value(spec["loudness"])
            self.suppress = False
            self.sync_sensitive()
            self.schedule()

        def on_slider(self, _scale):
            if self.suppress:
                return
            self.schedule()

        def sync_sensitive(self):
            enabled = ORDER[self.profile_row.get_selected()] != "off"
            for row in (self.bass_row, self.dialog_row, self.loud_row):
                row.set_sensitive(enabled)

        def schedule(self):
            key = ORDER[self.profile_row.get_selected()]
            bass = self.bass_row.scale.get_value()
            dialog = self.dialog_row.scale.get_value()
            loudness = self.loud_row.scale.get_value()
            self.target = targets(key, bass, dialog, loudness)
            self.pending_label = PROFILES[key]["label"]
            try:
                write_conf(key, bass, dialog, loudness)
            except OSError as exc:
                self.status.set_title(f"Could not save ({exc}).")
                return
            if self.node is None:
                self.node = find_filter_node()
            if self.node is None or not has_live_controls(self.node):
                self.status.set_title("Reloading audio…")
                try:
                    self.node = ensure_graph(key, bass, dialog, loudness)
                except (RuntimeError, subprocess.CalledProcessError) as exc:
                    self.status.set_title(f"Could not reload audio ({exc}).")
                    return
                self.live = dict(self.target)
                self.status.set_title(self.pending_label)
                return
            self.status.set_title("Fading…")
            if self.ramp_id is None:
                self.ramp_id = GLib.timeout_add(30, self.on_ramp)

        def on_ramp(self):
            self.live, done = approach(self.live, self.target)
            try:
                push_params(self.node, self.live)
            except subprocess.CalledProcessError:
                self.node = find_filter_node()
                if self.node is None:
                    self.ramp_id = None
                    self.status.set_title("Audio graph went away.")
                    return False
                try:
                    push_params(self.node, self.live)
                except subprocess.CalledProcessError as exc:
                    self.ramp_id = None
                    self.status.set_title(f"Could not update audio ({exc.returncode}).")
                    return False
            if done:
                self.ramp_id = None
                self.status.set_title(self.pending_label)
                return False
            return True

    app = SpeakerApp()
    raise SystemExit(app.run(sys.argv))


if __name__ == "__main__":
    result = main_cli(sys.argv[1:])
    if result is None:
        main_gui()
    else:
        raise SystemExit(result)
