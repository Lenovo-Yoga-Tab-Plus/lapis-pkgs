#!/bin/sh
# Settings → About reads virtualization from systemd, which treats the
# Gunyah placeholder at /proc/device-tree/hypervisor as a virtual machine
# and caches that result for the whole boot. The kernel still needs the
# node. Hide it from userspace, then ask pid 1 to read it again.
# The Processor row stays empty unless /proc/cpuinfo has a model name.
# arm64 does not emit one.

set -eu

mkdir -p /run/lapis/empty-hypervisor

if ! mountpoint -q /proc/device-tree/hypervisor; then
	mount --bind /run/lapis/empty-hypervisor /proc/device-tree/hypervisor
fi

if ! mountpoint -q /proc/cpuinfo; then
	awk '
		/^processor[[:space:]]*:/ {
			print
			print "model name\t: Snapdragon 8 Gen 3"
			next
		}
		{ print }
	' /proc/cpuinfo > /run/lapis/cpuinfo
	mount --bind /run/lapis/cpuinfo /proc/cpuinfo
fi

virt=$(busctl get-property org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager Virtualization 2>/dev/null || true)
case "$virt" in
*vm-other*)
	if [ ! -f /run/lapis/virt-reexeced ]; then
		: > /run/lapis/virt-reexeced
		# A blocking reexec from this service deadlocks pid 1.
		systemctl --no-block daemon-reexec
	fi
	;;
esac
